{
  "name": "yuanyuan",
  "version": "1.0.0",
  "description": "园园 - 一个会陪你的桌面小魔女",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "scan": "python3 tools/scan_assets.py",
    "dist": "node node_modules/electron-builder/cli.js"
  },
  "author": "CGW",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cgw.yuanyuan",
    "productName": "园园",
    "copyright": "Copyright © 2026 CGW",
    "icon": "build/icon.ico",
    "afterPack": "tools/afterPack.js",
    "files": [
      "**/*",
      "!tools/**",
      "!Material/**",
      "!**/*.log",
      "!_bbox*.py",
      "!_mkicon.py"
    ],
    "extraResources": [
      { "from": "Material/frames_transparent/covering_face", "to": "Material/frames_transparent/covering_face" },
      { "from": "Material/frames_transparent/heart", "to": "Material/frames_transparent/heart" },
      { "from": "Material/frames_transparent/lying_read", "to": "Material/frames_transparent/lying_read" },
      { "from": "Material/frames_transparent/pout_angry", "to": "Material/frames_transparent/pout_angry" },
      { "from": "Material/frames_transparent/running_happy", "to": "Material/frames_transparent/running_happy" },
      { "from": "Material/frames_transparent/sitting_broom", "to": "Material/frames_transparent/sitting_broom" },
      { "from": "Material/frames_transparent/sitting_read", "to": "Material/frames_transparent/sitting_read" },
      { "from": "Material/frames_transparent/sleep", "to": "Material/frames_transparent/sleep" },
      { "from": "Material/frames_transparent/spinning", "to": "Material/frames_transparent/spinning" },
      { "from": "Material/frames_transparent/standing_wiggle", "to": "Material/frames_transparent/standing_wiggle" },
      { "from": "Material/frames_transparent/typing_left", "to": "Material/frames_transparent/typing_left" },
      { "from": "Material/frames_transparent/walk_left_right", "to": "Material/frames_transparent/walk_left_right" },
      { "from": "Material/frames_transparent/walk_slow_left", "to": "Material/frames_transparent/walk_slow_left" },
      { "from": "Material/frames_transparent/向左走", "to": "Material/frames_transparent/向左走" },
      { "from": "Material/frames_transparent/起床", "to": "Material/frames_transparent/起床" },
      { "from": "Material/动态/烟雾", "to": "Material/动态/烟雾" },
      { "from": "Material/静态动作", "to": "Material/静态动作" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "园园",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
